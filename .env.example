# Supabase project configuration (use the project's publishable key only in browser-safe variables)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only secrets must NEVER use NEXT_PUBLIC_ prefix.
SUPABASE_SECRET_KEY=

# Random high-entropy value (32+ chars), server-only; required for L1 bootstrap.
FIRST_ADMIN_SETUP_SECRET=

# Server-only transactional email configuration for invitations and password resets.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
