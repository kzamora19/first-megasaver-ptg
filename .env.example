# Browser-safe Supabase project configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only secrets. Never use a NEXT_PUBLIC_ prefix.
SUPABASE_SECRET_KEY=
FIRST_ADMIN_SETUP_SECRET=

# Supabase Edge Function email delivery (set as Supabase Function secrets before deployment)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
PTG_APP_URL=https://kzamora19.github.io/first-megasaver-ptg
PTG_ALLOWED_ORIGINS=https://kzamora19.github.io

# Migration feature flags (false preserves the current Vercel API paths)
NEXT_PUBLIC_PTG_USE_EDGE_AUTH=false
NEXT_PUBLIC_PTG_USE_EDGE_DATA=false
NEXT_PUBLIC_PTG_USE_EDGE_ASSETS=false
NEXT_PUBLIC_PTG_USE_EDGE_ACCOUNTS=false
